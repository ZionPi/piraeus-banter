server {
    listen 80;
    listen [::]:80;
    server_name api-us.benjoe.top;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api-us.benjoe.top;

    ssl_certificate /etc/letsencrypt/live/api-us.benjoe.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-us.benjoe.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PiraeusTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /api/health {
        proxy_pass http://127.0.0.1:3270;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    location = /api/gemini/generate {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:3270;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Piraeus-Token $http_x_piraeus_token;
        proxy_connect_timeout 10s;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
        proxy_request_buffering on;
    }

    location = /api/url-to-text {
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3270;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Piraeus-Token $http_x_piraeus_token;
        proxy_connect_timeout 10s;
        proxy_read_timeout 140s;
        proxy_send_timeout 140s;
    }

    location = /api/convert-to-text {
        client_max_body_size 26m;
        proxy_pass http://127.0.0.1:3270;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Piraeus-Token $http_x_piraeus_token;
        proxy_connect_timeout 10s;
        proxy_read_timeout 140s;
        proxy_send_timeout 140s;
        proxy_request_buffering off;
    }

    location = /api/dialogize {
        client_max_body_size 26m;
        proxy_pass http://127.0.0.1:3270;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Piraeus-Token $http_x_piraeus_token;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
    }

    location / {
        return 404;
    }
}
